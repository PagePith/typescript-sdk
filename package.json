{
  "name": "@pagepith/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the PagePith API",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/openapi.ts",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm generate && pnpm typecheck && pnpm test && pnpm build && publint && attw --pack .",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.27.10",
    "openapi-typescript": "^7.6.1",
    "publint": "^0.3.4",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "pagepith",
    "scraping",
    "web-scraping",
    "markdown",
    "monitoring",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PagePith/typescript-sdk.git"
  },
  "homepage": "https://pagepith.com",
  "bugs": {
    "url": "https://github.com/PagePith/typescript-sdk/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
